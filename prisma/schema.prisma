generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════
// NÚCLEO COMÚN — USUARIOS Y AUTENTICACIÓN
// ════════════════════════════════════════
model Usuario {
  id             String  @id @default(uuid()) // RT-001: UUID como PK
  nombres        String
  // Adenda 2026-08-06: apellidos/identificacion pasan a opcionales -- el
  // registro autónomo (WF-AUT nuevo) solo pide nombre completo, correo y
  // teléfono. La creación por un administrador (CreateUsuarioDto) sigue
  // exigiendo estos dos campos a nivel de validación.
  apellidos      String?
  identificacion String? @unique
  correo         String  @unique // WF-AUT-001: correo único
  telefono       String? // Adenda 2026-08-06: requerido en el registro autónomo
  password       String
  rol            String
  // activo ahora también sirve para que un administrador bloquee el
  // acceso por uso irregular de la aplicación (Adenda 2026-08-06).
  activo         Boolean @default(true)

  // Adenda 2026-08-06: verificación de correo para el registro autónomo.
  // Los usuarios creados por un administrador (UsuariosService.crear)
  // quedan verificados de una vez -- ya hay un humano vouching por ellos.
  correoVerificado        Boolean   @default(false)
  tokenVerificacion       String?   @unique
  tokenVerificacionExpira DateTime?

  // Adenda 2026-08-08: eliminación lógica (RT-006/AT-005, mismo criterio
  // que Procedimiento) -- deliberadamente separado de `activo`, que ya
  // se usa para bloqueo/desbloqueo temporal. Un usuario bloqueado sigue
  // existiendo en el listado; uno eliminado, no.
  eliminado   Boolean   @default(false)
  eliminadoEn DateTime?

  procedimientos Procedimiento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usuarios")
}

// ════════════════════════════════════════
// ENTIDAD PRINCIPAL
// ════════════════════════════════════════
model Procedimiento {
  id                     String   @id @default(uuid())
  numeroInterno          String?  @unique // EST-AAAA-CONSECUTIVO (FLUJO 1.1)
  fechaCreacion          DateTime @default(now())
  nunc                   String? // RN-008: editable después de generar documentos
  fechaCaptura           DateTime
  horaCaptura            String
  // Adenda 2026-08-01: fechaDisposicion/horaDisposicion pasan a ser
  // opcionales. No se conocen al momento de crear el procedimiento (el
  // funcionario solo las sabe una vez el informe se entrega a la
  // Fiscalía) — exigirlas en la creación no correspondía a la realidad
  // operativa. Se completan después, vía actualización del procedimiento.
  fechaDisposicion       DateTime?
  horaDisposicion        String?
  delito                 String
  tipoProcedimiento      String // ESTÁNDAR | COMPLEJO (PC-001)
  estado                 String @default("Borrador") // Borrador | Finalizado
  observacionesGenerales String?

  // RT-006 / AT-005: no eliminación física. `activo=false` = eliminación
  // lógica autorizada por el administrador.
  activo        Boolean   @default(true)
  eliminadoEn   DateTime?

  // Adenda 2026-08-06: un administrador puede exonerar un procedimiento
  // puntual del requisito de pago (ver DocumentosService.verificarPagoAprobado),
  // para poder generar documentos aunque no haya un pago Verificado.
  exoneradoPago Boolean @default(false)

  // Adenda 2026-08-13: un administrador puede desbloquear puntualmente
  // la edición y regeneración de documentos de un procedimiento que ya
  // había quedado congelado (ver ProcedimientoAccesoService.
  // verificarNoBloqueado y DocumentosService.
  // verificarDocumentoNoGeneradoAntes) -- necesario cuando hace falta
  // corregir o completar información para que los documentos queden
  // completos. Interruptor manual, igual criterio que exoneradoPago: el
  // administrador lo activa y lo desactiva cuando corresponda.
  edicionDesbloqueada Boolean @default(false)

  usuarioId String // WF-AUT-005: cada usuario ve solo sus procedimientos
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  funcionarioActuante  FuncionarioActuante?
  companeroPatrulla    CompaneroPatrulla?
  lugarProcedimiento   LugarProcedimiento?
  actuacionesProcedimiento ActuacionesProcedimiento?
  capturados           Capturado[]
  testigos             Testigo[]
  victimas             Victima[]
  documentosGenerados  DocumentoGenerado[]
  pago                 Pago?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("procedimientos")
}

// ════════════════════════════════════════
// FUNCIONARIO ACTUANTE (1:1 con Procedimiento)
// ════════════════════════════════════════
model FuncionarioActuante {
  id String @id @default(uuid())

  procedimientoId String        @unique
  procedimiento   Procedimiento @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)

  nombreCompleto String
  documento      String
  entidad        String
  cargo          String
  telefono       String
  correo         String
  placa          String
  zonaAtencion   String
  estacion       String
  servicio       String
  cai            String? // Adenda 2026-07-25: requerido por los ejemplos de redacción aprobados ("CAI La Esperanza", "CAI Tintal"); PLANTILLA_INTELIGENTE.md lo lista como campo independiente de Estación y Zona de Atención.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("funcionario_actuante")
}

// ════════════════════════════════════════
// COMPAÑERO DE PATRULLA (1:1 con Procedimiento)
// ════════════════════════════════════════
model CompaneroPatrulla {
  id String @id @default(uuid())

  procedimientoId String        @unique
  procedimiento   Procedimiento @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)

  nombreCompleto String
  documento      String
  placa          String
  grado          String? // Adenda 2026-07-25: requerido para individualizar al compañero en la narración ("PT. Nombre Apellido, placa X"), tal como exigen los ejemplos de redacción aprobados.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companero_patrulla")
}

// ════════════════════════════════════════
// LUGAR DEL PROCEDIMIENTO (1:1 con Procedimiento)
// ════════════════════════════════════════
model LugarProcedimiento {
  id String @id @default(uuid())

  procedimientoId String        @unique
  procedimiento   Procedimiento @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)

  departamento    String
  municipio       String
  localidad       String?
  barrio          String
  direccion       String
  caracteristicas String?

  // Adenda 2026-08-22: existencia de cámaras en el lugar de los hechos
  // -- antes era una pregunta que la IA hacía en cada generación de
  // narrativa (core-transversal.md), ahora es un campo estructurado que
  // se diligencia una sola vez, igual que testigos/víctimas. Transversal
  // a todos los delitos (vive en el CORE, no en un prompt de delito).
  existenCamaras     Boolean?
  descripcionCamaras String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lugares_procedimiento")
}

// ════════════════════════════════════════
// CAPTURADO / APREHENDIDO (1:N con Procedimiento)
// ════════════════════════════════════════
model Capturado {
  id String @id @default(uuid())

  procedimientoId String        @map("procedimiento_id")
  procedimiento   Procedimiento @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)

  // Calculado automáticamente por el sistema (WF-M2, nunca ingresado manualmente)
  tipoInterviniente String // CAPTURADO | APREHENDIDO

  primerNombre        String
  segundoNombre        String?
  primerApellido       String
  segundoApellido      String?
  tipoDocumento        String?
  numeroDocumento      String?
  expedicionDocumento  String?
  fechaNacimiento      DateTime? // Adenda 2026-08-03: nullable — la persona puede no aportarla; en ese caso se usa edadManual (solo en el DTO, no se persiste) y edad se guarda con lo digitado por el funcionario.
  lugarNacimiento      String? // Adenda: campo opcional agregado a solicitud del usuario (2026-07-17). No siempre se aporta este dato en campo.
  edad                 Int // calculada, solo lectura
  genero               String
  estadoCivil          String?
  ocupacion            String?
  correo               String?
  redesSociales        String? // Adenda 2026-07-19: requerido por el FPJ-6 (Acta de Derechos)
  direccion            String?
  telefono             String?
  descripcionFisicaVestimenta String? // Adenda 2026-08-03: descripción física y de vestimenta del interviniente, a solicitud del usuario.
  senalesParticulares  String?
  nombrePadres         String?
  telefonoPadres       String?
  escolaridad          String? // Adenda 2026-07-20: requerido por el FPJ-5 (sección 4, "Escolaridad").
  alias                String? // Adenda 2026-07-20: requerido por el FPJ-5 (sección 4, "Alias, seudónimo o apodo").

  // Adenda 2026-07-22: datos individuales del Bloque 5/6 necesarios para
  // la narrativa IA (uno por interviniente, a diferencia de los campos de
  // ActuacionesProcedimiento que son generales del procedimiento).
  participacionHechos  String? // qué hizo esta persona específicamente (portaba, consumía, comercializaba, ocultaba, etc.)
  comportamientoAbordaje String? // colaboración, resistencia, intento de fuga, agresividad, etc.

  // Adenda 2026-08-22: antecedentes y pertenencia a organización
  // delincuencial -- antes eran preguntas obligatorias que la IA hacía
  // en cada generación de narrativa exclusivamente para adolescentes
  // (reglas-srpa.md 8-B/8-C). Ahora son campos estructurados que se
  // diligencian una sola vez, igual que esposas, y quedan disponibles
  // para cualquier interviniente (no exclusivos de SRPA) -- a solicitud
  // del usuario, transversal a todos los delitos.
  tieneProcedimientosAnteriores       Boolean?
  descripcionProcedimientosAnteriores String?
  perteneceGrupoDelincuencial         Boolean?
  descripcionGrupoDelincuencial       String?

  // Adenda 2026-08-03: uso de esposas pasa de una sola respuesta a nivel
  // de procedimiento (ActuacionesProcedimiento) a una pregunta individual
  // por interviniente. Solo aplica en la práctica a Aprehendidos (el
  // frontend solo la muestra para ese tipo), pero se deja disponible en
  // el modelo para cualquier interviniente por si cambia el criterio.
  usoEsposas           Boolean?
  justificacionEsposas String?
  // Adenda 2026-08-11: tiempo y motivo de retiro, antes solo se pedía el
  // momento -- a solicitud del usuario.
  tiempoEsposado       String?
  motivoRetiroEsposas  String?

  identificacionPlena  Boolean @default(true)
  formaIdentificacion  String? // si no se identificó plenamente, cómo se logró establecer la identidad

  // Adenda 2026-08-11: lesiones pasa de ser una sola respuesta a nivel de
  // procedimiento (antes en ActuacionesProcedimiento) a individual por
  // interviniente, igual que ya pasó con esposas -- cada persona puede
  // tener lesiones distintas (o ninguna). Se agregan parteCuerpoLesion y
  // motivoLesion, que antes no existían.
  presentaLesiones          Boolean?
  descripcionLesiones       String?
  parteCuerpoLesion         String?
  motivoLesion              String?
  // Adenda 2026-08-22 (módulo Lesiones Personales): quién causó la
  // lesión y con qué -- transversal a todos los delitos (a solicitud
  // del usuario), no exclusivo de Lesiones Personales. Texto libre en
  // ambos casos: "quién" puede ser un tercero no identificado o la
  // comunidad, no necesariamente otro interviniente del procedimiento;
  // "con qué" no se vincula a un elemento incautado aunque exista uno
  // (ej. "golpes de puño" no tiene elemento que incautar).
  causanteLesion            String?
  elementoCausante          String?
  trasladoCentroAsistencial Boolean?
  centroAsistencial         String?
  motivoTraslado            String?

  contactoNotificacion ContactoNotificacion?
  elementosIncautados  ElementoIncautado[]

  // Adenda 2026-08-21: lectura de derechos pasa de ser una sola respuesta
  // a nivel de procedimiento (antes en ActuacionesProcedimiento) a
  // individual por interviniente -- mismo criterio ya aplicado a
  // esposas/lesiones. Motivo: cada persona puede haber sido capturada o
  // aprehendida en un momento distinto, así que la lectura de derechos
  // (y la hora de captura que de ahí se deriva) no puede ser una sola
  // respuesta compartida para todo el procedimiento.
  //
  // fechaCaptura/horaCaptura AQUÍ es el momento real en que ESTA persona
  // fue capturada/aprehendida (se informan los derechos en ese momento).
  // Para el cálculo de demora del procedimiento se usa la más antigua
  // entre todos los intervinientes (ver demora.util.ts), con
  // Procedimiento.fechaCaptura/horaCaptura (capturados en la creación,
  // antes de que existan intervinientes) como respaldo mientras ningún
  // interviniente la haya diligenciado todavía.
  derechosLeidos    Boolean?
  fechaCaptura      DateTime?
  horaCaptura       String?
  comprendeDerechos Boolean?

  // Adenda 2026-08-12: exclusivo del módulo de Porte Ilegal de Armas de
  // Fuego -- individual por interviniente, igual que esposas/lesiones.
  // Distingue Porte de Tenencia porque en Colombia un permiso de
  // Tenencia (guardar el arma en un lugar fijo) NO cubre el Porte
  // (llevarla encima en la calle) -- son cosas legalmente distintas.
  tipoPermisoArma String? // PORTE | TENENCIA | NINGUNO

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RI-021 (UI-021): no puede haber dos intervinientes con mismo tipo+número
  // de documento dentro del mismo procedimiento.
  @@unique([procedimientoId, tipoDocumento, numeroDocumento])
  @@map("capturados")
}

// ════════════════════════════════════════
// TESTIGOS DE LOS HECHOS (1:N con Procedimiento) — Adenda 2026-08-20
// Núcleo común: transversal a todos los delitos, no se duplica por
// módulo (AT-003). Sección 5 del FPJ 5, hasta ahora fija en N/A.
// Misma dinámica de diligenciamiento que Capturado.
// ════════════════════════════════════════
model Testigo {
  id String @id @default(uuid())

  procedimientoId String
  procedimiento   Procedimiento @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)

  primerNombre    String
  segundoNombre   String?
  primerApellido  String
  segundoApellido String?

  tipoDocumento       String?
  numeroDocumento     String?
  expedicionDocumento String?

  fechaNacimiento DateTime?
  edad            Int?
  genero          String?

  // Lugar de nacimiento dividido en país/departamento/municipio, a
  // solicitud del usuario (Capturado solo tiene un campo libre
  // `lugarNacimiento`; para testigos se pidió desglosado).
  paisNacimiento         String?
  departamentoNacimiento String?
  municipioNacimiento    String?

  profesionOficio String?
  estadoCivil     String?
  direccion       String?
  telefono        String?
  correo          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testigos")
}

// ════════════════════════════════════════
// VÍCTIMAS (1:N con Procedimiento) — Adenda 2026-08-21 (módulo Hurto)
// Núcleo común: transversal a todos los delitos, no se duplica por
// módulo (AT-003). Sección 4 del FPJ 5 -- para Estupefacientes se
// mantiene la Regla automática (N/A, "la víctima corresponde al bien
// jurídico protegido Salud Pública"); para Hurto y futuros delitos que
// sí tengan víctimas identificables, se diligencia este listado.
// Misma dinámica de diligenciamiento que Capturado/Testigo.
// ════════════════════════════════════════
model Victima {
  id String @id @default(uuid())

  procedimientoId String
  procedimiento   Procedimiento @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)

  primerNombre    String
  segundoNombre   String?
  primerApellido  String
  segundoApellido String?

  tipoDocumento       String?
  numeroDocumento     String?
  expedicionDocumento String?

  fechaNacimiento DateTime?
  edad            Int?
  genero          String?

  paisNacimiento         String?
  departamentoNacimiento String?
  municipioNacimiento    String?

  profesionOficio String?
  estadoCivil     String?
  direccion       String?
  telefono        String?
  correo          String?

  // Único campo que Víctima tiene y Testigo no: relación con el
  // indiciado/interviniente (ej. "desconocido", "conocido de vista",
  // "cliente de la aplicación", "conductor de la plataforma"). Texto
  // libre -- no un FK al Capturado, porque describe el TIPO de
  // relación, no necesariamente a un interviniente identificado
  // (puede haber varios intervinientes o ninguno plenamente
  // identificado todavía).
  relacionIndiciado String?

  // Adenda 2026-08-22 (módulo Lesiones Personales): estado físico de la
  // víctima -- mismo criterio y mismos campos que ya existen en
  // Capturado (individual, no una sola respuesta compartida), salvo
  // motivoLesion (esa pregunta tiene sentido para un interviniente que
  // pudo lesionarse por su propia resistencia; para una víctima el
  // delito mismo es la causa, así que no aplica). Núcleo común --
  // cualquier delito con víctimas identificables puede necesitar este
  // bloque, no exclusivo de Lesiones Personales.
  presentaLesiones          Boolean?
  descripcionLesiones       String?
  parteCuerpoLesion         String?
  causanteLesion            String?
  elementoCausante          String?
  trasladoCentroAsistencial Boolean?
  centroAsistencial         String?
  motivoTraslado            String?

  // Adenda 2026-08-22 (módulo Violencia contra Servidor Público):
  // exclusivo de este delito -- toda víctima registrada bajo este
  // delito es, por definición, un servidor público, por eso no hay un
  // booleano "esServidorPublico" separado: si el procedimiento es de
  // este delito, el frontend siempre solicita estos campos. Entidad en
  // texto libre (no fija en "Policía Nacional") porque el tipo penal
  // protege a cualquier servidor público, no solo a la Policía.
  entidadServidorPublico   String?
  cargoServidorPublico     String?
  uniformado               Boolean?
  enEjercicioFunciones     Boolean?
  indiciadoConocioCalidad  Boolean?

  // Adenda 2026-08-22 (módulo Violencia Intrafamiliar): exclusivo de
  // este delito. relacionFamiliar es texto libre (a solicitud del
  // usuario, sin selector de categorías fijas).
  relacionFamiliar                   String?
  existenMedidasProteccion           Boolean?
  descripcionMedidasProteccion       String?
  existenAntecedentesViolencia       Boolean?
  descripcionAntecedentesViolencia   String?

  elementosIncautados ElementoIncautado[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("victimas")
}

// ════════════════════════════════════════
// CONTACTO DE NOTIFICACIÓN (1:1 con Capturado)
// ════════════════════════════════════════
model ContactoNotificacion {
  id String @id @default(uuid())

  capturadoId String    @unique
  capturado   Capturado @relation(fields: [capturadoId], references: [id], onDelete: Cascade)

  nombre                        String?
  // Adenda 2026-08-11: faltaba -- a solicitud del usuario, junto con
  // nombre/teléfono.
  parentesco                    String?
  identificacion                String? // Adenda 2026-07-19: requerido por el FPJ-6 (Acta de Derechos)
  telefono                      String?
  comunicacionExitosa           Boolean
  horaComunicacion               String?
  justificacionNoComunicacion    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contactos_notificacion")
}

// ════════════════════════════════════════
// ELEMENTOS INCAUTADOS (1:N con Capturado)
// ════════════════════════════════════════
model ElementoIncautado {
  id String @id @default(uuid())

  procedimientoId String
  // Adenda 2026-08-14: capturadoId pasa a ser OPCIONAL. Cuando es null,
  // el elemento quedó "sin individualizar" -- hallado en un lugar común
  // (ej. el interior de un vehículo con varios ocupantes) sin poder
  // atribuirse a una persona específica, pero que de todas formas dio
  // lugar a la captura de todos los intervinientes del procedimiento.
  // En ese caso, `ubicacionHallazgo` debe describir el lugar físico
  // exacto (ej. "interior del vehículo, debajo del asiento del
  // conductor"), no una ubicación corporal.
  capturadoId     String?
  capturado       Capturado? @relation(fields: [capturadoId], references: [id], onDelete: Cascade)

  // Adenda 2026-08-21 (módulo Hurto): a qué víctima le fue hurtado este
  // elemento -- opcional porque no todos los delitos ni todos los
  // elementos tienen una víctima asociada (ej. sustancias en
  // Estupefacientes). Uso operativo exclusivo de Hurto, pero se agrega
  // a nivel de ElementoIncautado (y no de un modelo aparte) porque ya
  // es la entidad transversal de elementos del Núcleo Común -- mismo
  // criterio que capturadoId opcional para "sin individualizar".
  victimaId String?
  victima   Victima? @relation(fields: [victimaId], references: [id], onDelete: SetNull)

  // Adenda 2026-08-21 (módulo Hurto): si el bien hurtado fue recuperado
  // y por quién (policía/víctima/comunidad, texto libre). Uso operativo
  // exclusivo de Hurto.
  recuperado    Boolean?
  recuperadoPor String?

  // Adenda 2026-08-23 (módulo Receptación): cómo se estableció que este
  // elemento tiene reporte de hurto -- consulta en un aplicativo
  // policial, o denuncia presentada por un tercero ante los
  // funcionarios. Uso operativo exclusivo de Receptación.
  fuenteVerificacionHurto String? // APLICATIVO | DENUNCIA

  // Datos propios de la fuente "APLICATIVO".
  nombreAplicativo        String?
  numeroReporteAplicativo String?

  // Datos propios de la fuente "DENUNCIA". El denunciante se registra
  // aquí con datos simples (no como Víctima -- puede ser un tercero que
  // solo reporta, no necesariamente la víctima original del hurto).
  numeroDenuncia       String?
  entidadDenuncia      String?
  fechaDenuncia        DateTime?
  denuncianteNombre    String?
  denuncianteDocumento String?
  denuncianteTelefono  String?

  tipoElemento        String // SUSTANCIA | DINERO | CELULAR | ARMA | OTRO
  descripcionBase     String // RN-006/RN-007: única, generada automáticamente
  ubicacionHallazgo   String
  direccionIncautacion String
  observaciones       String? // Adenda 2026-07-18: observaciones puntuales del funcionario sobre este elemento, reflejadas en el Acta de Incautación.

  detalleSustancia DetalleSustancia?
  detalleDinero    DetalleDinero?
  detalleCelular   DetalleCelular?
  detalleArma      DetalleArma?
  detalleOtro      DetalleOtroElemento?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("elementos_incautados")
}

model DetalleSustancia {
  id                String            @id @default(uuid())
  elementoId        String            @unique
  elemento          ElementoIncautado @relation(fields: [elementoId], references: [id], onDelete: Cascade)
  cantidadEmpaques  Int
  // Adenda 2026-08-11: cómo viene empacada la sustancia (bolsas,
  // papeletas, frascos, cajas, pastillas...), a solicitud del usuario --
  // antes la descripción siempre decía "empaques" de forma genérica.
  tipoEmpaque       String?
  tipoSustancia     String
  color             String
  caracteristicas   String

  @@map("detalle_sustancias")
}

model DetalleDinero {
  id             String            @id @default(uuid())
  elementoId     String            @unique
  elemento       ElementoIncautado @relation(fields: [elementoId], references: [id], onDelete: Cascade)
  valorTotal     Decimal
  denominaciones String

  @@map("detalle_dinero")
}

// Adenda 2026-08-12: módulo de Porte Ilegal de Armas de Fuego. Alcance
// confirmado por el usuario: solo armas de fuego (pistola, revólver,
// escopeta, fusil) y armas hechizas/artesanales, con su munición — NO
// incluye armas blancas, traumáticas ni artefactos explosivos.
model DetalleArma {
  id         String            @id @default(uuid())
  elementoId String            @unique
  elemento   ElementoIncautado @relation(fields: [elementoId], references: [id], onDelete: Cascade)

  tipoArma String // PISTOLA | REVOLVER | ESCOPETA | FUSIL | HECHIZA
  marca    String?
  // Adenda 2026-08-20: se elimina "modelo" -- a solicitud del usuario,
  // no se utiliza operativamente en campo.
  calibre  String?
  color    String?

  // Adenda 2026-08-13: cacha/empuñadura -- material (madera, plástica,
  // etc.) y color, a solicitud del usuario.
  cachaMaterial String?
  cachaColor    String?

  // Adenda 2026-08-13: el serial borrado/alterado es legalmente
  // relevante (agravante) -- se deja como verificación siempre
  // explícita, no opcional. Reemplaza el booleano anterior por un
  // estado categórico de 5 opciones (una de ellas, LEGIBLE, habilita el
  // campo `serial` con el número transcrito).
  serial        String?
  estadoSerial  String // LEGIBLE | NO_PRESENTA | BORRADO | ALTERADO | NO_LEGIBLE

  // Estado del arma: únicamente estas 3 opciones (a solicitud del
  // usuario, no es texto libre).
  estadoArma String // BUEN_ESTADO | REGULAR_ESTADO | MAL_ESTADO

  cantidadMuniciones Int?
  // Adenda 2026-08-13: calibre de la MUNICIÓN, preguntado de forma
  // independiente -- nunca debe asumirse igual al calibre del arma.
  calibreMunicion    String?
  cantidadCargadores Int?

  @@map("detalle_armas")
}

model DetalleCelular {
  id         String            @id @default(uuid())
  elementoId String            @unique
  elemento   ElementoIncautado @relation(fields: [elementoId], references: [id], onDelete: Cascade)
  marca      String
  color      String
  imei       String?

  @@map("detalle_celulares")
}

model DetalleOtroElemento {
  id                String            @id @default(uuid())
  elementoId        String            @unique
  elemento          ElementoIncautado @relation(fields: [elementoId], references: [id], onDelete: Cascade)
  descripcionManual String

  @@map("detalle_otros_elementos")
}

// ════════════════════════════════════════
// ACTUACIONES PROCEDIMENTALES (1:1 con Procedimiento)
// ════════════════════════════════════════
model ActuacionesProcedimiento {
  id String @id @default(uuid())

  procedimientoId String        @unique
  procedimiento   Procedimiento @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)

  // Adenda 2026-08-21: derechosLeidos/fechaDerechos/horaDerechos/
  // comprendeDerechos se quitan de aquí (eran una sola respuesta para
  // todo el procedimiento) y pasan a Capturado, individual por
  // interviniente -- mismo criterio ya aplicado a esposas/lesiones/
  // permiso de arma. Ver el modelo Capturado (fechaCaptura/horaCaptura).

  // Adenda 2026-08-03: usoEsposas/justificacionEsposas se quitan de aquí
  // (eran una sola respuesta para todo el procedimiento) y pasan a
  // Capturado, como pregunta individual por interviniente Aprehendido
  // (menor de edad) — a solicitud del usuario, para procedimientos
  // mixtos donde solo a algunos intervinientes se les colocan esposas.

  // Adenda 2026-08-11: presentaLesiones/descripcionLesiones/
  // trasladoCentroAsistencial/centroAsistencial/motivoTraslado se
  // quitan de aquí (eran una sola respuesta para todo el procedimiento)
  // y pasan a Capturado, como pregunta individual por interviniente,
  // mismo criterio ya aplicado a usoEsposas.

  autoridadReceptora String

  // Adenda 2026-08-20: en procedimientos MIXTOS (adultos y adolescentes
  // a la vez), la autoridad receptora puede ser distinta para cada
  // grupo (ej. URI ordinaria para los mayores, URI de Infancia y
  // Adolescencia para los menores) -- a solicitud del usuario. Cuando
  // el procedimiento es mixto, el frontend pide estos dos campos en vez
  // del campo único `autoridadReceptora` de arriba (que se sigue
  // usando tal cual para procedimientos no mixtos).
  autoridadReceptoraAdultos String?
  autoridadReceptoraMenores String?

  // Adenda 2026-08-04: demoraExistente se quita de aquí — se calcula
  // siempre al vuelo (nunca como snapshot) en demora.util.ts, para que
  // nunca quede desactualizado sin importar si se edita primero la
  // lectura de derechos o la puesta a disposición. justificacionDemora sí
  // sigue siendo contenido real escrito por el usuario, se conserva.
  justificacionDemora   String?

  // Adenda 2026-07-22: campos del Bloque 5/6 del Formulario Maestro
  // ("Relato de los Hechos"), agregados por decisión del usuario para
  // reducir la dependencia del ciclo de aclaraciones de la narrativa IA.
  // No estaban en el Modelo de Datos V1 original.
  observacionInicial     String? // qué observó el personal que motivó la intervención (patrullaje, información previa, actitud sospechosa, etc.)
  desarrolloIntervencion String? // cómo se desarrolló el abordaje/registro personal

  tieneCircunstanciaRelevante Boolean @default(false)
  circunstanciaRelevante      String?

  // Adenda 2026-08-20: existencia de testigos de los hechos (Sección 5
  // del FPJ 5, hasta ahora fija en N/A) -- Sí/No a nivel de
  // procedimiento, igual que tieneCircunstanciaRelevante/
  // tieneObservacionAdicional. Si es Sí, se diligencia el listado de
  // Testigo (ver modelo abajo), con la misma dinámica que Intervinientes.
  existenTestigos Boolean?

  // Adenda 2026-08-21 (módulo Hurto): existencia de víctimas
  // identificables (Sección 4 del FPJ 5). Mismo patrón que
  // existenTestigos. No aplica a Estupefacientes (regla automática N/A
  // ya vigente en ese módulo se mantiene sin cambios).
  existenVictimas Boolean?

  tieneObservacionAdicional Boolean @default(false)
  observacionAdicional      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("actuaciones_procedimiento")
}

// ════════════════════════════════════════
// DOCUMENTOS GENERADOS (1:N con Procedimiento)
// ════════════════════════════════════════
model DocumentoGenerado {
  id String @id @default(uuid())

  procedimientoId String        @map("procedimiento_id")
  procedimiento   Procedimiento @relation(fields: [procedimientoId], references: [id])

  tipoDocumento String // FPJ5 | FPJ6 | ACTA | FPJ7 | FPJ8
  capturadoId   String?
  elementoId    String?

  fechaGeneracion     DateTime @default(now())
  version             Int      @default(1)
  procedimientoVersion Int
  rutaArchivo         String
  estado              String // Generado | Regenerado | Anulado

  createdAt DateTime @default(now())

  @@map("documentos_generados")
}

// ════════════════════════════════════════
// PAGOS (1:1 con Procedimiento)
// ════════════════════════════════════════
model Pago {
  id String @id @default(uuid())

  procedimientoId String        @unique
  procedimiento   Procedimiento @relation(fields: [procedimientoId], references: [id])

  // Adenda 2026-08-06: fechaPago/medioPago/referenciaPago se quitan --
  // a solicitud del usuario, el funcionario ya no diligencia un
  // formulario de texto, solo adjunta el comprobante y el administrador
  // lee esos datos directamente del archivo al revisar.
  valor            Decimal
  comprobantePago  String // ahora siempre presente: ruta del archivo adjunto (obligatorio)
  estadoPago       String // Pendiente | Verificado | Rechazado

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pagos")
}

// ════════════════════════════════════════
// ASESORÍA COMPLEJA (1:1 con Procedimiento COMPLEJO) — Adenda V1.1
// ════════════════════════════════════════
// ════════════════════════════════════════
// CONFIGURACIÓN DE PAGOS (singleton, editable solo por ADMINISTRADOR)
// PC-004: el valor de la asesoría (y del procedimiento) es configurable.
// ════════════════════════════════════════
model ConfiguracionPagos {
  id             String   @id @default(uuid())
  valorEstandar  Decimal
  valorComplejo  Decimal

  // Adenda 2026-08-07: métodos de pago que se muestran al funcionario en
  // el Bloque 8, cada uno con su propio interruptor de habilitado/
  // deshabilitado y sus datos editables desde el panel de administración.
  nequiHabilitado Boolean @default(false)
  nequiNumero     String?

  cuentaHabilitada Boolean @default(false)
  cuentaBanco      String?
  cuentaTipo       String? // Ahorros | Corriente
  cuentaNumero     String?

  tarjetaHabilitada    Boolean @default(false)
  tarjetaInstrucciones String?

  // Adenda 2026-08-08: datos de contacto que se muestran al funcionario
  // en el Bloque 8 tras adjuntar el comprobante en un procedimiento
  // COMPLEJO ("si un asesor no te ha contactado en 15 minutos...").
  contactoTelefono String?
  contactoCorreo   String?

  actualizadoPor String
  updatedAt      DateTime @updatedAt

  @@map("configuracion_pagos")
}

// ════════════════════════════════════════
// AUDITORÍA (RT-007 / AT-004) — no permite eliminación de registros
// ════════════════════════════════════════
model AuditoriaEvento {
  id                String   @id @default(uuid())
  fechaEvento       DateTime @default(now())
  usuario           String
  accion            String // Crear | Modificar | Regenerar | Anular | Eliminar (lógico)
  tablaAfectada     String
  registroAfectado  String
  descripcionEvento String

  @@map("auditoria_eventos")
}
